# Copy to .env and fill in. .env is gitignored. Never commit real secrets.
# Phase 0 uses none of these; they document the Phase 1 runtime contract.

# Which LLM provider adapter to use: mock (offline) or anthropic (live).
LLM_PROVIDER=mock

# Anthropic API key, required only when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Postgres / pgvector connection string.
DATABASE_URL=postgresql://ai_ops:change_me_local_only@localhost:5432/ai_ops

# Which config (domain) to run.
CONFIG_NAME=demo_quarry
